# --- Local development -------------------------------------------------------
# Start a local Postgres with `npm run db:local`, then copy the TCP URL it prints.
# pgbouncer=true disables prepared statements (required for the local server and
# for pooled connections in production).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1"
# Scratch database `prisma migrate dev` uses to check migrations. The local
# server provides one on the next port. Not needed in production.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=1"

# Shared secret for /api/cron/sync. Generate with: openssl rand -hex 32
CRON_SECRET="change-me"

# Public URL, used for canonical links, sitemap, and social cards.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Production (e.g. Neon) --------------------------------------------------
# DATABASE_URL = pooled connection string + "&pgbouncer=true&connection_limit=1"
# DIRECT_URL   = direct (non-pooled) connection string, used for migrations
